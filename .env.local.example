NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe (see lib/stripe.ts) -- optional: every checkout/subscription
# action falls back to direct activation when STRIPE_SECRET_KEY is
# unset, so the app runs without these. Set them to actually charge
# through Stripe Checkout instead.
STRIPE_SECRET_KEY=sk_test_...
# From Stripe Dashboard -> Developers -> Webhooks, once an endpoint is
# registered for https://your-domain/api/webhooks/stripe listening to
# checkout.session.completed. Required for that webhook to accept
# events at all (see app/api/webhooks/stripe/route.ts).
STRIPE_WEBHOOK_SECRET=whsec_...
# Not read anywhere yet: this app's Checkout flow redirects to a
# Stripe-hosted session (checkout.sessions.create -> session.url), which
# never loads @stripe/stripe-js client-side. Only needed if an embedded
# Stripe Elements flow replaces that redirect later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase service role key (Settings -> API -> service_role, secret).
# Bypasses RLS -- only ever read server-side, by the Stripe webhook
# (lib/supabase/service-role.ts), which has no user session to scope a
# normal request to. Required for the webhook to actually activate a
# subscription after a real payment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
